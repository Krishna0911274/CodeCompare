const copyBtn =
  document.getElementById(
    "copyBtn"
  );

if (copyBtn) {

  copyBtn.addEventListener(
    "click",
    async function () {

      const output =
        document.getElementById(
          "output"
        );


      if (!output) {
        return;
      }


      try {

        await navigator.clipboard.writeText(
          output.textContent
        );


        copyBtn.textContent =
          "Copied!";


        setTimeout(
          function () {

            copyBtn.innerHTML =
              '<i class="fa-regular fa-copy"></i> Copy';

          },
          1500
        );


      } catch (error) {

        console.error(
          "Copy failed:",
          error
        );

      }

    }
  );
}


